{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // "node" for the component tests (node:test, node:fs). They used to get Node's
    // types only by accident, through eleventy-plugin-vite's type declaration
    // importing vite's; that declaration went with the plugin (ADR 0049).
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/components/**/*.ts",
    "src/types/**/*.ts"
  ]
}
