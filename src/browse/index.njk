---
layout: base.njk
title: Browse — PNW Moths
permalink: /browse/index.html
description: "Browse every species account on the site by family, subfamily, tribe, and genus — over 1,200 moths of the Pacific Northwest."
---
<h1>Browse all species</h1>

<p>For the same species as a names-only list in taxonomic sequence, see the
<a href="{{ '/checklist/' | url }}">Checklist</a>.</p>

<script type="application/json" id="taxon-data" data-pagefind-ignore>
  {{ taxon | tojson | safe }}
</script>

<pnwm-taxon-browser path-prefix="{{ '/' | url }}"></pnwm-taxon-browser>

<noscript data-pagefind-ignore>
  {% for family in taxon %}
    <h2 id="family-{{ family.name | lower }}">{{ family.name }}</h2>
    {% for subfam in family.subfamilies %}
      {# Heading levels track effective depth: a null subfamily/tribe flattens its
         children up a level so the outline (h2 family → … → genus) never skips. #}
      {% if subfam.name %}
        <h3 id="family-{{ family.name | lower }}--subfamily-{{ subfam.name | lower }}">{{ subfam.name }}</h3>
      {% endif %}
      {% set tribeLevel = 4 if subfam.name else 3 %}
      {% for tribe in subfam.tribes %}
        {% if tribe.name %}
          <h{{ tribeLevel }} id="family-{{ family.name | lower }}{% if subfam.name %}--subfamily-{{ subfam.name | lower }}{% endif %}--tribe-{{ tribe.name | lower }}">{{ tribe.name }}</h{{ tribeLevel }}>
        {% endif %}
        {% set genusLevel = (tribeLevel + 1) if tribe.name else tribeLevel %}
        {% for genus in tribe.genera %}
          <h{{ genusLevel }} id="family-{{ family.name | lower }}{% if subfam.name %}--subfamily-{{ subfam.name | lower }}{% endif %}{% if tribe.name %}--tribe-{{ tribe.name | lower }}{% endif %}--genus-{{ genus.genus_slug }}">{{ genus.name }}</h{{ genusLevel }}>
          <ul>
            {% for sp in genus.species %}
              <li><a href="{{ ('/species/' + sp.slug + '/') | url }}">
                <em>{{ genus.name }} {{ sp.name }}</em>{% if sp.common_name %} — {{ sp.common_name }}{% endif %}
              </a></li>
            {% endfor %}
          </ul>
        {% endfor %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
</noscript>
