---
pagination:
  data: speciesRedirects
  size: 1
  alias: r
permalink: "species/{{ r.oldSlug }}/index.html"
layout: false
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0; url={{ ('/species/' + r.newSlug + '/') | url }}">
  {#- vite-ignore: eleventy-plugin-vite's html asset scanner treats EVERY <link href>
     as a copyable asset regardless of rel (DEFAULT_HTML_ASSET_SOURCES has no filter for
     "link" the way it does for "meta"). It then tries to fs.readFile this directory-style
     "/species/{slug}/" URL as a local file, throwing EISDIR. The vite-ignore attribute
     tells Vite's html plugin to skip processing this node's href entirely. -#}
  <link rel="canonical" href="{{ ('/species/' + r.newSlug + '/') | url }}" vite-ignore>
  <meta name="robots" content="noindex">
  <title>Redirecting… | PNW Moths</title>
</head>
<body>
  <p>
    This species account has moved.
    <a href="{{ ('/species/' + r.newSlug + '/') | url }}">Continue to the current page</a>.
  </p>
  <script>window.location.replace({{ ('/species/' + r.newSlug + '/') | url | dump | safe }});</script>
</body>
</html>
