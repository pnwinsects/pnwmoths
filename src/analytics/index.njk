---
layout: base.njk
title: Site Analytics — PNW Moths
permalink: /analytics/index.html
eleventyExcludeFromCollections: true
robots: noindex, nofollow
description: "Pageview and visitor statistics for Pacific Northwest Moths, collected nightly from CDN access logs."
---

<h1>Site Analytics</h1>

{% if analytics.days.length === 0 %}
<p>No analytics data yet. Data is collected nightly from CDN access logs.</p>
{% else %}

<p>Tracking data since <strong>{{ analytics.cumulative.first_date }}</strong>.
All-time totals: <strong>{{ analytics.cumulative.total_pageviews | number }}</strong> pageviews{% if analytics.cumulative.total_unique_visitors > 0 %},
<strong>{{ analytics.cumulative.total_unique_visitors | number }}</strong> unique visitors{% endif %}.
Use the time filter below to view stats for a specific year.</p>

<script type="application/json" id="analytics-data" data-pagefind-ignore>
  {{ analytics | tojson | replace("<", "\\u003c") | safe }}
</script>

<pnwm-analytics-dashboard></pnwm-analytics-dashboard>

{% set referrals = analytics.rolling30.legacy_referrals %}
<section id="legacy-referral-sources" aria-labelledby="legacy-referral-heading" data-pagefind-ignore>
  <h2 id="legacy-referral-heading">Sites Linking to Retired WWU URLs (Last 30 Days)</h2>
  <p>External sites sending page requests to the retired PNW Moths hostnames.
    This report uses the initial 301 request, not subsequent requests to the new site,
    and is independent of the year filter above.</p>
  {% if referrals.days_collected === 0 %}
  <p>Not collected yet. This report starts with the next nightly analytics collection;
    historical files do not contain this information.</p>
  {% else %}
  <p>Reporting window: <strong>{{ referrals.window_start }}</strong> to <strong>{{ referrals.window_end }}</strong> (UTC).
    Collection available for <strong>{{ referrals.days_collected }} of 30 days</strong>,
    from {{ referrals.first_date }} to {{ referrals.last_date }}.
    {% if referrals.days_collected < 30 %}Partial coverage: uncollected days are not counted as zero traffic.{% endif %}</p>
  <p>{{ referrals.total_requests | number }} initial legacy-host requests:
    <strong>{{ referrals.external_requests | number }} externally referred</strong>,
    {{ referrals.unknown_referrer_requests | number }} with no usable referrer,
    {{ referrals.internal_referrer_requests | number }} with an internal referrer, and
    {{ referrals.excluded_requests | number }} excluded as assets/downloads, browser defaults,
    scanner probes, or recognized automation.</p>
  {% if referrals.sources.length > 0 %}
  <p>Top 25 referring domains, ranked by requests; expand a row for up to five most-requested old paths.
    Counts combine HTTP and HTTPS and the leading <code>www.</code> alias.</p>
  <table>
    <thead><tr><th scope="col">Referring domain</th><th scope="col">Old paths requested</th><th scope="col">Requests</th></tr></thead>
    <tbody>
      {% for source in referrals.sources %}
      <tr>
        <td>{{ source.domain | escape }}</td>
        <td>
          <details>
            <summary>Top old paths</summary>
            <ul>
              {% for item in source.paths %}
              <li><code>{{ item.path | escape }}</code> ({{ item.count | number }} requests)</li>
              {% endfor %}
            </ul>
          </details>
        </td>
        <td>{{ source.count | number }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No externally referred legacy page requests were recorded on the collected days.</p>
  {% endif %}
  {% endif %}
  <p>These are outreach leads, not verified people or unique visits. Referrers can be absent or forged;
    bot filtering is heuristic. Bookmarks, privacy settings, apps, HTTPS-to-HTTP links, and cached
    redirects can hide sources or visits. Only referring domains and old paths are retained;
    query strings and referring-page URLs are not.</p>
</section>

<noscript>
  <h2>Top Pages (Last 30 Days)</h2>
  <table>
    <thead><tr><th>Page</th><th>Views</th></tr></thead>
    <tbody>
      {% for page in analytics.rolling30.top_pages.slice(0, 20) %}
      <tr><td>{{ page.path }}</td><td>{{ page.count }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Top Referrers</h2>
  <table>
    <thead><tr><th>Domain</th><th>Hits</th></tr></thead>
    <tbody>
      {% for ref in analytics.rolling30.top_referrers.slice(0, 10) %}
      <tr><td>{{ ref.domain }}</td><td>{{ ref.count }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Top Countries</h2>
  <table>
    <thead><tr><th>Country</th><th>Hits</th></tr></thead>
    <tbody>
      {% for c in analytics.rolling30.top_countries.slice(0, 10) %}
      <tr><td>{{ c.code }}</td><td>{{ c.count }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  {% if analytics.rolling30.top_redirect_misses.length > 0 %}
  <h2>Unmapped Legacy Links (Last 30 Days)</h2>
  <p>{{ analytics.rolling30.redirect_hits.missed | number }} of
    {{ analytics.rolling30.redirect_hits.total | number }} old-site links found no specific page.</p>
  <table>
    <thead><tr><th>Old URL</th><th>Linked from</th><th>Hits</th></tr></thead>
    <tbody>
      {% for miss in analytics.rolling30.top_redirect_misses.slice(0, 10) %}
      <tr><td>{{ miss.from }}</td><td>{{ miss.referrer or "—" }}</td><td>{{ miss.count }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if analytics.rolling30.top_not_found.length > 0 %}
  <h2>Top 404s (Last 30 Days)</h2>
  <table>
    <thead><tr><th>Path</th><th>Hits</th></tr></thead>
    <tbody>
      {% for nf in analytics.rolling30.top_not_found.slice(0, 10) %}
      <tr><td>{{ nf.path }}</td><td>{{ nf.count }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</noscript>

{% endif %}
