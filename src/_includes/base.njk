<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "PNW Moths" }}</title>
  {#- Sharing metadata (issue #198). Pages contribute `description`, and optionally
     `socialImage` / `socialImageAlt` / `ogType`; everything else falls back to the
     site defaults registered in eleventy.config.ts.

     Every URL below is ABSOLUTE (`| url` for pathPrefix, then `| absoluteUrl` for
     the origin). Crawlers require that — and it is also what keeps these tags away
     from eleventy-plugin-vite's HTML asset scanner, which treats every <link href>
     and the og:image <meta content> as a copyable local asset but skips external
     URLs. A root-relative canonical here would repeat the EISDIR failure that
     src/species-redirect.njk documents. See docs/lessons-learned.md. -#}
  {%- set pageDescription = description or siteDescription -%}
  {#- Alt text has to track the image, not the page: species with no photos on file
     set an empty `socialImage` and fall back to the site card, and would otherwise
     describe it as a specimen photograph of themselves. -#}
  {%- if socialImage -%}
    {%- set pageSocialImage = socialImage -%}
    {%- set pageSocialImageAlt = socialImageAlt or siteImageAlt -%}
  {%- else -%}
    {%- set pageSocialImage = "/images/social-card.png" | url | absoluteUrl -%}
    {%- set pageSocialImageAlt = siteImageAlt -%}
  {%- endif -%}
  {%- set pageUrl = page.url | url | absoluteUrl -%}
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ pageUrl }}">
  <meta property="og:site_name" content="{{ siteName }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title or 'PNW Moths' }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ pageSocialImage }}">
  <meta property="og:image:alt" content="{{ pageSocialImageAlt }}">
  {#- Twitter/X reads og:title, og:description and og:image when the twitter:*
     equivalents are absent, so only the card type needs stating. Bluesky, Slack,
     Discord and Signal all read the Open Graph tags above. -#}
  <meta name="twitter:card" content="summary_large_image">
  <!-- Assets under public/ (Vite publicDir) are referenced with a plain
       root-absolute path and NO `| url` filter: Vite rewrites them with `base`,
       which is the same pathPrefix. Applying `| url` here would both double the
       prefix source-of-truth and defeat Vite's public-file short-circuit,
       reintroducing a per-page fs.readFile. Page links below still use `| url`. -->
  <link rel="icon" href="/favicon.ico" sizes="16x16" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600&family=Spinnaker&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/pico.min.css">
  <link rel="stylesheet" href="/styles/theme.css">
</head>
<body>
  {#- Bypass block (WCAG 2.4.1): the banner, eight nav links and the search field
     are nine tab stops repeated on every page. The link is visually hidden until
     focused; see .skip-link in theme.css. -#}
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header>
    <div class="banner">
      <img src="/images/header.png"
          alt="Pacific Northwest moths — a row of specimen photographs on black">
      <div class="pnwm-site-name">Pacific Northwest Moths</div>
    </div>
    <nav class="site-nav" data-pagefind-ignore>
      <ul>
        <li><a href="{{ '/' | url }}">Home</a></li>
        <li><a href="{{ '/browse/' | url }}">Browse</a></li>
        <li><a href="{{ '/identify/' | url }}">Identify</a></li>
        <li><a href="{{ '/plates/' | url }}">Plates</a></li>
        <li><a href="{{ '/glossary/' | url }}">Glossary</a></li>
        <li><a href="{{ '/faqs/' | url }}">FAQs</a></li>
        <li><a href="{{ '/about/' | url }}">About</a></li>
        <li><a href="{{ '/contact/' | url }}">Contact</a></li>
      </ul>
      <div class="site-search" id="site-search">
        <input type="search" class="site-search-input" placeholder="Search…" aria-label="Search site">
        {#- No role="listbox": the results are plain <a> elements, and a listbox
           whose children are not role="option" is invalid ARIA (axe
           aria-required-children). A real combobox (roving aria-activedescendant,
           ArrowDown into the list) is tracked separately.
           This container is NOT the live region: it is [hidden] (display:none, so
           out of the accessibility tree) while doSearch() fills it, and revealing
           an already-populated element is not a live update — nothing would be
           announced. The always-rendered status element below carries the count. -#}
        <div class="site-search-results" id="site-search-results" aria-label="Search results" hidden></div>
        <p class="sr-only" id="site-search-status" role="status"></p>
      </div>
    </nav>
  </header>
  {#- tabindex="-1" makes <main> a valid target for the skip link: without it the
     browser moves the scroll position but leaves focus on <body>, so the next Tab
     returns to the top of the nav. -#}
  <main id="main-content" tabindex="-1">
    <div class="content-wrapper">
      {{ content | safe }}
    </div>
  </main>
  {#- Named so it forms a `region` landmark: this block sits between <main> and
     <footer>, and an unlabelled <section> leaves its content outside every
     landmark (axe `region`). -#}
  <section class="partners-banner" aria-label="Partner institutions and funders" data-pagefind-ignore>
    <div class="partners-inner">
      <div class="partners-group">
        <h2 class="partners-heading">An Institutional Partnership Between</h2>
        <ul class="partners-logos">
          {% for partner in partners.collaborators %}
          <li>
            <a href="{{ partner.url }}" title="{{ partner.name }}" target="_blank" rel="noopener">
              <img src="/images/logos/{{ partner.logo }}" alt="{{ partner.name }}" loading="lazy">
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
      <div class="partners-group">
        <h2 class="partners-heading">Funding</h2>
        <ul class="partners-logos">
          {% for partner in partners.funders %}
          <li>
            <a href="{{ partner.url }}" title="{{ partner.name }}" target="_blank" rel="noopener">
              <img src="/images/logos/{{ partner.logo }}" alt="{{ partner.name }}" loading="lazy">
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>
  <footer>
    <p><a href="{{ '/contact/' | url }}">Contact us</a></p>
    <p>Pacific Northwest Moths. Licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">Creative Commons Attribution-NonCommercial-ShareAlike 4.0</a>.</p>
  </footer>
  <script type="module" src="/components/main.js"></script>
  <script type="module">
    (async () => {
      const input = document.querySelector('.site-search-input');
      const resultsEl = document.getElementById('site-search-results');
      const statusEl = document.getElementById('site-search-status');
      if (!input || !resultsEl) return;

      // Announce the outcome through a permanently-visible-to-AT status element.
      // resultsEl itself cannot do this: it is display:none while being filled.
      function announce(message) {
        if (statusEl) statusEl.textContent = message;
      }

      let pagefind;
      try {
        const pagefindUrl = '{{ '/pagefind/pagefind.js' | url }}';
        pagefind = await import(/* @vite-ignore */ pagefindUrl);
        await pagefind.options({ baseUrl: '{{ '/' | url }}' });
      } catch {
        return; // Pagefind not available (dev mode)
      }

      let debounceTimer;
      input.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => doSearch(), 200);
      });

      // Close results on click outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.site-search')) {
          resultsEl.hidden = true;
        }
      });

      // Reopen on focus if there's a query
      input.addEventListener('focus', () => {
        if (input.value.trim() && resultsEl.innerHTML) {
          resultsEl.hidden = false;
        }
      });

      function esc(s) {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      async function doSearch() {
        const query = input.value.trim();
        if (!query) { resultsEl.hidden = true; resultsEl.innerHTML = ''; announce(''); return; }
        const search = await pagefind.search(query);
        const results = await Promise.all(search.results.slice(0, 8).map(r => r.data()));
        if (!results.length) {
          resultsEl.innerHTML = '<p class="site-search-empty">No results found.</p>';
          announce('No results found.');
        } else {
          // The list is capped at 8, so report the cap explicitly rather than
          // announcing "8 results" when the query actually matched far more.
          const total = search.results.length;
          announce(total > results.length
            ? `Showing ${results.length} of ${total} results for ${query}.`
            : `${total} result${total === 1 ? '' : 's'} for ${query}.`);
          resultsEl.innerHTML = results.map(r =>
            `<a class="site-search-result" href="${esc(r.url)}">
              <span class="site-search-result-title">${esc(r.meta?.title || r.url)}</span>
              <span class="site-search-result-excerpt">${r.excerpt}</span>
            </a>`
          ).join('');
        }
        resultsEl.hidden = false;
      }
    })();
  </script>
</body>
</html>
